<Window x:Class="SmartWPF.Core.Controls.FluentDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartWPF.Core.Controls"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent">

    <Window.Resources>
        <Geometry x:Key="InfoIconPath">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z</Geometry>
        <Geometry x:Key="SuccessIconPath">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z</Geometry>
        <Geometry x:Key="WarningIconPath">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</Geometry>
        <Geometry x:Key="ErrorIconPath">M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z</Geometry>
        <Geometry x:Key="ConfirmIconPath">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z</Geometry>
    </Window.Resources>

    <Border Padding="24">
        <!-- 对话框卡片 -->
        <Border x:Name="DialogCard"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource CornerRadiusLG}"
                MinWidth="320" MaxWidth="440"
                SnapsToDevicePixels="True"
                RenderTransformOrigin="0.5,0.5"
                Opacity="0">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowKeyColor}"
                                  BlurRadius="32"
                                  ShadowDepth="8"
                                  Direction="270"
                                  Opacity="0.8"/>
            </Border.Effect>

            <Grid Margin="{DynamicResource ContainerPaddingLG}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题行 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            Margin="0,0,0,12">
                    <Viewbox Width="24" Height="24" Margin="0,0,12,0">
                        <Path x:Name="IconPath"
                              Fill="{DynamicResource InfoBrush}"
                              Data="{StaticResource InfoIconPath}"/>
                    </Viewbox>
                    <TextBlock x:Name="TitleText"
                               Style="{DynamicResource HeadingMD}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 消息内容 -->
                <TextBlock x:Name="MessageText"
                           Grid.Row="1"
                           Style="{DynamicResource BodyText}"
                           Foreground="{DynamicResource ForegroundSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,24"
                           MaxWidth="400"/>

                <!-- 按钮区域 -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Style="{DynamicResource ButtonGhost}"
                            MinWidth="80" Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="OnCancelClick"/>
                    <Button x:Name="SecondaryButton"
                            Style="{DynamicResource ButtonSecondary}"
                            MinWidth="80" Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="OnSecondaryClick"/>
                    <Button x:Name="PrimaryButton"
                            Style="{DynamicResource ButtonPrimary}"
                            MinWidth="80"
                            Click="OnPrimaryClick"
                            IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
